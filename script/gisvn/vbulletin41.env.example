# GISVN vBulletin 4.1.7 -> Discourse migration environment
#
# Copy to a file OUTSIDE Git, e.g. /root/gisvn-vbulletin41.env,
# protect it with chmod 600, and replace all placeholders.
#
# The source MySQL account should be read-only.

export RAILS_ENV="production"

export DB_HOST="127.0.0.1"
export DB_NAME="gisvn_vbulletin"
export DB_USER="gisvn_import_ro"
export DB_PW="<SOURCE_MYSQL_PASSWORD>"

# Confirm this from the historical vBulletin config/database.
export TABLE_PREFIX="vb_"

# Confirm the historical server/forum timezone before production import.
# GISVN operated for a Vietnamese audience, but do not rely on browser timestamps
# as proof of the server timezone.
export TIMEZONE="Asia/Ho_Chi_Minh"

# Required when vBulletin attachments were stored on disk.
# If files were stored in MySQL, keep the directory available anyway; the
# importer can fall back to database filedata where present.
export ATTACHMENT_DIR="/srv/gisvn-vbulletin/attachments"

# Optional path used by the GISVN wrapper for logs/reports.
export GISVN_MIGRATION_DIR="/var/tmp/gisvn-migration"
